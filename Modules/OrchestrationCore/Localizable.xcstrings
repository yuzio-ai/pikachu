        }
      }
    },
    "执行会话标识与历史绑定不一致，没有发送任务。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The active session ID does not match the history binding. The task was not sent."
