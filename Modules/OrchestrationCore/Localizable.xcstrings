    },
    "会话标识不匹配。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session ID does not match."
          }
        }
      }
    },
    "会话连接已变化，请重试模型查询。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session connection has changed. Try loading the models again."
          }
        }
      }
    },
    "停止结果尚未确认。请结束受管进程。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stop could not be confirmed. End the managed processes."
          }
        }
      }
    },
    "历史会话" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historical Session"
          }
        }
      }
    },
    "历史工作目录与当前位置不同。旧会话可只读查看；请在当前位置新建会话。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session’s historical working directory differs from the current one. You can browse the old session read-only or start a new session in the current location."
          }
        }
      }
    },
    "历史文件缺失，已阻止继续发送。请恢复原文件或在新会话中执行。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The history file is missing and sending is blocked. Restore the file or start a new session."
