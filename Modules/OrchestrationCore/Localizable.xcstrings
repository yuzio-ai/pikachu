        }
      }
    },
    "发送状态未能持久化，没有发送任务。请先修复本地存储。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The delivery state could not be saved. The task was not sent. Fix local storage first."
