    "/" : {
      "shouldTranslate" : false
    },
    "%@\n\n将移除此项目及其在 Pikachu 中的偏好、会话条目和草稿。共有 %lld 个会话，%lld 个会话含草稿。\n\n磁盘上的项目文件和智能体的远端历史会保留。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nThis removes the project and its preferences, session entries, and drafts from Pikachu. Sessions: %lld. Sessions with drafts: %lld.\n\nProject files and remote agent history are kept."
          }
        }
      }
    },
